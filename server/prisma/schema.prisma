generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  password     String   
  name         String
  imageUrl     String?
  bio          String?
  edu          String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  chats        Chat[]
  messages     Message[]

  @@map("profiles")
}

model Chat {
  id        String    @id @default(uuid())
  name      String?   
  chatImg   String?   
  isGroup   Boolean   @default(false)
  createdAt DateTime  @default(now())

  profiles  Profile[]
  messages  Message[]

  @@map("chats")
}

model Message {
  id        String   @id @default(uuid())
  content   String?
  imageUrl  String?  
  createdAt DateTime @default(now())

  senderId  String
  sender    Profile  @relation(fields: [senderId], references: [id])

  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}